<html>
<head>
<title>공지사항</title>
<meta http-equiv='Content-Type' content='text/html;charset=euc-kr'>
<style type='text/css'>
<!--
	p,div	{font-size:9pt;font-family:"굴림";color:#565656;line-height:14pt}
	.title	{font-size:11pt;font-family:"돋움";color:#445050}
-->
</style>
</head>
<body style='margin:0' marginwidth=0 marginheight=0 bgcolor=#FFFFFF>
<table width="100%" height="100%" border=0 cellpadding=0 cellspacing=0>
  <tr>
    <td align=center valign=top>
      <table width=100% border=0 cellpadding=0 cellspacing=0 background='gonggi/default/img/popWin_headBG.gif'>
        <tr align=right valign=top>
          <td><img src='gonggi/default/img/popWin_head.gif' border=0></td>
        </tr>
        <tr align=right valign=top>
          <td width=90% align=left bgcolor=#C5D5F7><div class="title"><img src='gonggi/default/img/popWin_arrow.gif' border=0 align=absmiddle>{SUBJECT}</div></td>
        </tr>
      </table>
      <table width=100% border=0 cellpadding=0 cellspacing=0>
        <tr>
          <td align=center>
            <table width=95% border=0 cellpadding=0 cellspacing=0>
              <tr>
                <td style="word-break:break-all">
<p align=left><br>
<!-- body -->
{COMMENT}
<!-- body -->
<br></p>
                </td>
              </tr>
              <tr><td align="right">{DATE}</td></tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td align=center valign=bottom>
      <table width="100%" border=0 cellpadding=0 cellspacing=0>
        <tr bgcolor=#C9CDCF><td colspan=4><img src='gonggi/default/img/dummy.gif'></td></tr>
        <tr bgcolor=#EDEDED>
          <td align=right><img src='gonggi/default/img/popWin_close.gif' border=0 style="cursor:hand" onClick='window.close()'></td>
          <td width=10><img src='gonggi/default/img/dummy.gif' width=25 height=32></td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
