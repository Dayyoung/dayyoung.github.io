<html>
<head>
<title>공지사항</title>
<meta http-equiv="Content-Type" content="text/html; charset=euc-kr">
<style type="text/css">
<!--
A:link, A:visited, A:active { text-decoration:none; }
A:hover { color:#4F4F4F }
td {  font-size: 9pt}
.bg {  background-attachment: fixed; background-image: url(gonggi/skin_02/img/dot.gif); background-repeat: repeat-x}
-->
</style>
<script>
<!--
function open_win(url)
{
	window.open(url, 'popupwindow', 'width=320, height=240, scrollbars=yes, resizable=yes');
}
-->
</script>
</head>

<body bgcolor="#FFFFFF" text="#000000" link="#000000" vlink="#000000" alink="#000000">
<table width="100%" border="0" cellspacing="0" cellpadding="0">
  <!-- BEGIN DYNAMIC BLOCK: tr -->
  <tr>
    <td height="20" width="20" align="center"><img src="gonggi/skin_02/img/arrow.gif" width="15" height="15" align="absmiddle"></td>
    <!-- BEGIN DYNAMIC BLOCK: preset_01 -->
    <td height="20" width="50" align="center">[{DATE_01}]</td>
    <!-- END DYNAMIC BLOCK: preset_01 -->
    <!-- BEGIN DYNAMIC BLOCK: subject -->
    <td height="20" width="*%"><div align="left">{LINK}</td>
    <!-- END DYNAMIC BLOCK: subject -->
    <!-- BEGIN DYNAMIC BLOCK: preset_02 -->
    <td height="20" width="50"><div align="right">[{DATE_02}]</div></td>
    <!-- END DYNAMIC BLOCK: preset_02 -->
  </tr>
  <tr> 
    <td class="bg" colspan="10"></td>
  </tr>
  <!-- END DYNAMIC BLOCK: tr -->
  <tr><td colspan="10" height="5"></td></tr>
  <tr> 
    <td colspan="10" align="right"><a href="{MORE}" target="{TARGET}"><img src='gonggi/skin_02/img/more.gif' border=0></a></td>
  </tr>
</table>
