<html>
<head>
<title>공지사항</title>
<meta http-equiv="Content-Type" content="text/html; charset=euc-kr">
</head>

<body bgcolor="#FFFFFF" text="#000000" leftmargin="0" topmargin="0" marginwidth="0" marginheight="0">
<table width="100%" border="0" cellspacing="5" cellpadding="0" height="100%">
  <tr>
    <td valign="top">
      <table width="100%" border="0" cellspacing="0" cellpadding="0" background="gonggi/skin_04/img/top_bg.gif">
        <tr>
          <td width="63"><img src="gonggi/skin_04/img/top1.gif" width="63" height="64"></td>
          <td valign="top"> 
            <table width="80%" border="0" cellspacing="0" cellpadding="15">
              <tr>
                <td><b>{SUBJECT}</b></td>
              </tr>
            </table>
          </td>
          <td align="right" width="64"><img src="gonggi/skin_04/img/top2.gif" width="53" height="64"></td>
        </tr>
      </table>
      <table width="100%" border="0" cellspacing="0" cellpadding="0" height="82%">
        <tr>
          <td width="15" background="gonggi/skin_04/img/left.gif">&nbsp;</td>
          <td align="center" valign="top"> 
            <table width="95%" border="0" cellspacing="0" cellpadding="0" height="95%">
              <tr> 
                <td height="17" valign="top">
{COMMENT}
                </td>
              </tr>
              <tr><td align="right">{DATE}</td></tr>
            </table>
          </td>
          <td width="12" background="gonggi/skin_04/img/right.gif">&nbsp;</td>
        </tr>
      </table>
      <table width="100%" border="0" cellspacing="0" cellpadding="0" background="gonggi/skin_04/img/bot_bg.gif">
        <tr>
          <td width="15"><img src="gonggi/skin_04/img/bot_left.gif" width="15" height="36"></td>
          <td align="center" valign="middle"><img src="gonggi/skin_04/img/but_close.gif" width="63" height="19" style="cursor:hand" onClick="window.close();"></td>
          <td align="right" width="12"><img src="gonggi/skin_04/img/bot_right.gif" width="12" height="36"></td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
